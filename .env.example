HOST=127.0.0.1
PORT=8787
AUTODS_URL=https://app.autods.com
MCP_PORT=8788
MCP_REQUIRE_AUTH=false
MCP_SHARED_SECRET=replace-with-a-local-secret-for-tunneled-use
# Social OAuth values belong in OS secret storage and are not read by default.
BROWSER_PROFILE_DIR=./.local/edge-autods-profile
SHOPIFY_STORE_NAME=MOTORYN
